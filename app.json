{
  "expo": {
    "name": "Nayou",
    "slug": "nayou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nayou",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ng.nayou.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nayou needs the microphone for voice calls.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00843D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.nayou.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E80840"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nayou needs your photos to add them to your profile.",
          "cameraPermission": "Nayou needs the camera to take your verification selfie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nayou uses your approximate location to show people near you."
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1"
    }
  }
}